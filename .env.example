# ── LLM Provider API Keys ───────────────────────────────────────────────────
# Uncomment and set the key for whichever provider you use.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token — required for scanning GitHub repos or orgs.
# Needs at least read:org and repo (public_repo for public-only) scopes.
# GITHUB_TOKEN=ghp_...

# ── OpenAI-compatible endpoint (vLLM, LiteLLM, Azure, Ollama, etc.) ─────────
# Set this to use a custom base URL instead of api.openai.com.
# OPENAI_COMPATIBLE_URL=http://localhost:11434/v1

# ── Vulnerability lookup ────────────────────────────────────────────────────
# The scanner always queries OSV.dev (free, no auth) for the detected
# framework+version. Optionally it can also ask an LLM with web-search
# enabled for very recent advisories that may not be in OSV yet.
#
# Supported providers (each reuses that provider's existing API key env var):
#   perplexity  →  requires PERPLEXITY_API_KEY
#   gemini      →  requires GOOGLE_API_KEY
#   openai      →  requires OPENAI_API_KEY
#   anthropic   →  requires ANTHROPIC_API_KEY
#   none        →  disable web search (OSV still runs)
# VULN_SEARCH_PROVIDER=anthropic
# PERPLEXITY_API_KEY=pplx-...
