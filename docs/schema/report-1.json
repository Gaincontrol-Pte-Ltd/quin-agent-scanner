{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Gaincontrol-Pte-Ltd/quin-agent-scanner/main/docs/schema/report-1.json",
  "title": "Quin Scanner report, schema 1.x",
  "description": "The JSON/YAML report written by `quin-scanner scan -o json|yaml`. Within schema major version 1 fields are never removed, renamed or retyped; new optional fields may appear, so consumers must ignore fields they do not know. See docs/schema/README.md.",
  "type": "object",
  "required": [
    "schema_version", "repo_path", "scan_timestamp", "is_ai_application", "confidence", "capability_tags",
    "framework", "summary", "agents", "tool_usages", "risk_signals", "mcp_servers", "infra", "vulnerabilities",
    "artifacts", "model_usages", "agent_tool_relationships", "inventory", "coverage", "llm_endpoints",
    "metadata", "skills", "file_hashes"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$", "description": "MAJOR.MINOR of this schema."},
    "repo_path": {"type": "string"},
    "scan_timestamp": {"type": "string", "description": "ISO 8601, UTC."},
    "is_ai_application": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "capability_tags": {"type": "array", "items": {"type": "string"}},
    "framework": {"type": "string", "description": "\"<Name> <version>\" or \"unknown\"."},
    "summary": {"type": "string"},
    "agents": {"type": "array", "items": {"$ref": "#/$defs/agent"}},
    "tool_usages": {"type": "array", "items": {"$ref": "#/$defs/toolUsage"}},
    "risk_signals": {"type": "array", "items": {"$ref": "#/$defs/riskSignal"}},
    "mcp_servers": {"type": "array", "items": {"$ref": "#/$defs/mcpServer"}},
    "infra": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/infra"}]},
    "vulnerabilities": {"type": "array", "items": {"$ref": "#/$defs/vulnerability"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "model_usages": {"type": "array", "items": {"$ref": "#/$defs/modelUsage"}},
    "agent_tool_relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "inventory": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "coverage": {"type": "object", "description": "Open map: documented keys are stable, others informational."},
    "llm_endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
    "metadata": {"type": "object", "description": "Open map: documented keys are stable, others informational."},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skillAssessment"}},
    "file_hashes": {"type": "array", "items": {"$ref": "#/$defs/fileHash"}},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "additionalProperties": true,
  "$defs": {
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "finding": {
      "type": "object",
      "required": ["scanner_name", "category", "file_path", "line_number", "match_text", "capability_tag", "confidence"],
      "properties": {
        "scanner_name": {"type": "string"},
        "category": {"type": "string"},
        "file_path": {"type": "string"},
        "line_number": {"type": ["integer", "null"]},
        "match_text": {"type": "string"},
        "capability_tag": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["file_path", "line_number", "scanner", "source_url"],
      "properties": {
        "file_path": {"type": "string"},
        "line_number": {"type": ["integer", "null"]},
        "scanner": {"type": "string"},
        "source_url": {"type": "string"}
      }
    },
    "riskSignal": {
      "type": "object",
      "required": ["signal", "recommended_controls", "threat_id", "severity", "evidence_refs"],
      "properties": {
        "signal": {"type": "string"},
        "recommended_controls": {"type": "array", "items": {"type": "string"}},
        "threat_id": {"type": ["string", "null"], "description": "T001 to T014, or null."},
        "severity": {"$ref": "#/$defs/severity"},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "agent_type", "goal", "capabilities", "risk_signals", "skills", "tools", "source_file"],
      "properties": {
        "name": {"type": "string"},
        "agent_type": {"type": "string"},
        "goal": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "risk_signals": {"type": "array", "items": {"$ref": "#/$defs/riskSignal"}},
        "skills": {"type": "array", "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "source_file": {"type": "string"}
      }
    },
    "toolUsage": {
      "type": "object",
      "required": ["tool_name", "tool_type", "service_category", "source_file", "line_number"],
      "properties": {
        "tool_name": {"type": "string"},
        "tool_type": {"type": "string", "description": "tool_definition, external_service, skill or mcp_tool."},
        "service_category": {"type": "string"},
        "source_file": {"type": "string"},
        "line_number": {"type": ["integer", "null"]}
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["name", "transport", "source_file"],
      "properties": {
        "name": {"type": "string"},
        "transport": {"type": "string"},
        "source_file": {"type": "string"}
      }
    },
    "infra": {
      "type": "object",
      "required": ["platform", "details", "source_files"],
      "properties": {
        "platform": {"type": "string"},
        "details": {"type": "array", "items": {"type": "string"}},
        "source_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "vulnerability": {
      "type": "object",
      "required": ["cve_id", "severity", "cvss_score", "published", "summary", "source", "source_url", "affected_versions"],
      "properties": {
        "cve_id": {"type": ["string", "null"]},
        "severity": {"type": "string", "description": "critical, high, medium, low or unknown."},
        "cvss_score": {"type": ["number", "null"]},
        "published": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "source": {"type": "string"},
        "source_url": {"type": ["string", "null"]},
        "affected_versions": {"type": ["string", "null"]}
      }
    },
    "modelUsage": {
      "type": "object",
      "required": ["provider", "model_name", "source", "file_path", "line_number", "role"],
      "properties": {
        "provider": {"type": "string"},
        "model_name": {"type": "string"},
        "source": {"type": "string"},
        "file_path": {"type": "string"},
        "line_number": {"type": "integer"},
        "role": {"type": "string"}
      }
    },
    "relationship": {
      "type": "object",
      "required": ["agent_name", "tool_name", "source_file", "line_number", "tool_source_file", "tool_line_number", "evidence"],
      "properties": {
        "agent_name": {"type": "string"},
        "tool_name": {"type": "string"},
        "source_file": {"type": "string"},
        "line_number": {"type": ["integer", "null"]},
        "tool_source_file": {"type": "string"},
        "tool_line_number": {"type": ["integer", "null"]},
        "evidence": {"type": "string"}
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["url", "host", "kind", "source", "file_path", "line_number", "key", "resolved_from"],
      "properties": {
        "url": {"type": "string", "description": "Credentials are redacted."},
        "host": {"type": "string"},
        "kind": {"type": "string"},
        "source": {"type": "string"},
        "file_path": {"type": "string"},
        "line_number": {"type": ["integer", "null"]},
        "key": {"type": "string"},
        "resolved_from": {"type": "string"}
      }
    },
    "fileHash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string"}
      }
    },
    "governance": {
      "type": "object",
      "description": "Present only with --detect-zino.",
      "required": ["zino_detected", "status", "evidence_kinds", "packages", "evidence"],
      "properties": {
        "zino_detected": {"type": "boolean"},
        "status": {"type": "string", "description": "governed, declared_only, ungoverned or not_applicable."},
        "evidence_kinds": {"type": "array", "items": {"type": "string"}},
        "packages": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "skillRecord": {
      "type": "object",
      "required": ["id", "name", "description", "root_path", "skill_md_path", "ecosystem", "allowed_tools", "files", "frontmatter_valid"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "root_path": {"type": "string"},
        "skill_md_path": {"type": "string"},
        "ecosystem": {"type": "string", "description": "claude, codex, opencode, generic, mcp or instructions."},
        "allowed_tools": {"type": "array", "items": {"type": "string"}},
        "files": {"type": "array", "items": {"type": "string"}},
        "frontmatter_valid": {"type": "boolean"}
      }
    },
    "skillFinding": {
      "type": "object",
      "required": ["rule_id", "skill_id", "severity", "category", "title", "file_path", "line_number", "evidence", "threat_id", "confidence", "llm_verdict", "explanation"],
      "properties": {
        "rule_id": {"type": "string"},
        "skill_id": {"type": "string"},
        "severity": {"$ref": "#/$defs/severity"},
        "category": {"type": "string"},
        "title": {"type": "string"},
        "file_path": {"type": "string"},
        "line_number": {"type": ["integer", "null"]},
        "evidence": {"type": "string", "description": "Redacted and capped at 500 characters."},
        "threat_id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "llm_verdict": {"type": "string", "description": "confirmed, disputed or none."},
        "explanation": {"type": "string"}
      }
    },
    "skillAssessment": {
      "type": "object",
      "required": ["record", "findings", "risk_score", "verdict", "finding_counts", "top_rule_ids"],
      "properties": {
        "record": {"$ref": "#/$defs/skillRecord"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/skillFinding"}},
        "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "verdict": {"type": "string", "enum": ["SAFE", "CAUTION", "HIGH_RISK"]},
        "finding_counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "top_rule_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
